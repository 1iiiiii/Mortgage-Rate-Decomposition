"""Shared matplotlib style. Import once at the top of every figure script:

    from plot_style import apply_style, COLORS, source_note

Figures carry a title, axis labels with units and a source line only.
No explanatory prose inside figures; a time axis shows actual dates.
"""
import matplotlib as mpl
import matplotlib.pyplot as plt

COLORS = {
    "total": "#1f2a44",      # dark navy: the series being decomposed
    "part1": "#2a7f9e",      # teal: first component
    "part2": "#e3a44a",      # amber: second component
    "accent": "#b0413e",     # red: a highlighted period or reference line
    "grey": "#8c8c8c",
}


def apply_style():
    mpl.rcParams.update({
        "figure.figsize": (9, 5),
        "figure.dpi": 110,
        "savefig.dpi": 200,
        "savefig.bbox": "tight",
        "font.size": 12,
        "axes.titlesize": 14,
        "axes.titleweight": "bold",
        "axes.titlelocation": "left",
        "axes.labelsize": 12,
        "axes.spines.top": False,
        "axes.spines.right": False,
        "axes.grid": True,
        "axes.grid.axis": "y",
        "grid.color": "#dddddd",
        "grid.linewidth": 0.8,
        "legend.frameon": False,
        "legend.fontsize": 11,
        "xtick.labelsize": 11,
        "ytick.labelsize": 11,
        "lines.linewidth": 1.8,
    })


def source_note(fig, text):
    """Source line in the bottom-left corner, outside the axes."""
    fig.text(0.01, -0.02, f"Source: {text}", ha="left", va="top",
             fontsize=9, color=COLORS["grey"])
